# Desarrollo en LAN: entra al front con http://<IP-del-servidor>:5173 (Vite: host: true en vite.config).
# Sin VITE_BACKEND_URL, el cliente usa el mismo hostname que la página → API en :3000 de esa IP.
# URL del backend (API). Opcional en desarrollo: sin esto, se usa el mismo host que el navegador
# (ej. entras por http://192.168.1.10:5173 → API en http://192.168.1.10:3000).
# VITE_BACKEND_URL=http://localhost:3000
# Si el API usa otro puerto con hostname automático:
# VITE_BACKEND_PORT=3000

# Imagen de fondo en login / registro / recuperar contraseña.
# Si no se define, se usa la imagen por defecto (authme / shutterstock).
# VITE_AUTH_BACKGROUND_IMAGE=https://i0.wp.com/authme.com/wp-content/uploads/2024/03/shutterstock_2231566279-1.webp
