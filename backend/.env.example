# --- Red: consumir el API desde otras PCs en tu Wi‑Fi/Ethernet ---
PORT=3000
# 0.0.0.0 = todas las interfaces (LAN + localhost). Solo esta máquina: HOST=127.0.0.1
HOST=0.0.0.0

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=smart_biometricauthenticator

JWT_SECRET=cambia-esto-en-produccion-minimo-32-caracteres

# Monitor de cámaras (intervalo en ms; 0 = desactivar monitor)
# CAMERA_MONITOR_ENABLED=0
# CAMERA_MONITOR_INTERVAL_MS=4000

# Detección de persona con COCO-SSD (solo clase «person» → alertas). 0 = sin ML (no habrá alertas de persona)
# CAMERA_PERSON_ML_ENABLED=1
# Umbral de confianza 0–1 (más alto = menos falsos positivos, más falsos negativos)
# CAMERA_PERSON_MIN_SCORE=0.32
# Redimensionar lado largo del JPEG antes de inferencia (más alto = mejor detección lejana, más CPU)
# CAMERA_PERSON_MAX_INPUT_SIDE=800
# Base COCO-SSD: mobilenet_v1 | mobilenet_v2 | lite_mobilenet_v2 (por defecto mobilenet_v2; lite = más rápido en CPU)
# CAMERA_PERSON_SSD_BASE=mobilenet_v2
# Log cuando hay detección "person" pero no supera el umbral: CAMERA_PERSON_DEBUG=1
# Mínimo tiempo entre alertas de la misma cámara (ms)
# CAMERA_PERSON_COOLDOWN_MS=75000

# Tras PERSON_DETECTED: segundos de espera si el admin no actúa antes de enviar correo a contactos (default 120000 = 2 min)
# ALERT_CONTACT_EMAIL_DELAY_MS=120000
# Cada cuánto el servidor comprueba alertas pendientes de escalación (ms)
# ALERT_ESCALATION_TICK_MS=10000
# 0 = no ejecutar escalación por correo
# ALERT_CONTACT_ESCALATION_ENABLED=1

# Usuario admin inicial (seed al arrancar si no existe)
DEFAULT_ADMIN_EMAIL=admin@securehome.local
DEFAULT_ADMIN_PASSWORD=SmartBioAuth2025!

# --- Correo cuando se detecta una persona (Gmail: activar 2FA y crear "contraseña de aplicación") ---
# 1 = enviar a todos los contactos activos que tengan email
MAIL_PERSON_ALERT_ENABLED=0
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465
# 1 = SSL (puerto 465). Para 587 usar MAIL_SMTP_PORT=587 y MAIL_SMTP_SECURE=0
MAIL_SMTP_SECURE=1
MAIL_SMTP_USER=tu-cuenta@gmail.com
# Pegar la contraseña de aplicación sin espacios
MAIL_SMTP_PASS=
MAIL_FROM=tu-cuenta@gmail.com
MAIL_FROM_NAME=SecureHome AI
# URL pública del frontend (sin barra final). El correo enlazará a: {MAIL_PUBLIC_BASE_URL}/?emergency=1&lat=...&lng=...&address=...&owner=...
# Ej. producción: https://mi-dominio.com  | desarrollo: http://localhost:5173
# Si se omite, el enlace del correo irá directo a OpenStreetMap con las coordenadas del admin.
# MAIL_PUBLIC_BASE_URL=http://localhost:5173
